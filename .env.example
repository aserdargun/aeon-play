# aeon-play Environment Configuration
# Copy this file to .env and adjust values as needed

# Server Configuration
PORT=8050
HOST=0.0.0.0
AEON_PLAY_DEBUG=false

# Cache Configuration
AEON_PLAY_CACHE_DIR=./.cache

# Data Limits (to protect server resources)
AEON_PLAY_MAX_CASES=10000
AEON_PLAY_MAX_TIMEPOINTS=5000
